{
  "schema_version": 1,
  "experiment_name": "wselob_xgboost_scale_v1",
  "purpose": "Scale and reproducibility engineering benchmark; not an alpha search.",
  "dataset": {
    "name": "WSELOB-2017",
    "license": "CC BY 4.0",
    "symbols": ["KGHM", "PKNORLEN", "PKOBP", "PZU", "PEKAO"],
    "date_start": "2017-01-01",
    "date_end": "2017-12-24",
    "session_start_local": "10:00:00",
    "session_end_local": "16:00:00",
    "timezone": "Europe/Warsaw",
    "horizons_events": [10, 20, 50],
    "book_levels": 10
  },
  "features": {
    "primary_set": [
      "spread_bps",
      "top_imbalance",
      "depth_imbalance",
      "ofi_l1_norm",
      "microprice_minus_mid_bps"
    ],
    "reuse_existing_causal_definitions": true,
    "no_new_features_after_test_inspection": true
  },
  "evaluation": {
    "split_unit": "calendar_month",
    "minimum_train_trading_days": 40,
    "expanding_train": true,
    "test_months": "all eligible months after minimum history",
    "train_must_strictly_precede_test": true,
    "cross_symbol_pooling": false,
    "primary_metric": "spearman_ic",
    "secondary_metrics": [
      "direction_accuracy_nonzero",
      "prediction_decile_monotonicity",
      "threshold_coverage_1bp",
      "selected_midpoint_diagnostic_bps"
    ],
    "aggregation": [
      "per_symbol_month",
      "equal_weight_symbol_month_mean",
      "per_symbol",
      "pooled_rows_for_descriptive_comparison_only"
    ],
    "overlapping_labels_are_dependent": true
  },
  "models": {
    "linear": {
      "enabled": true,
      "ridge": 1e-06,
      "train_only_standardization": true
    },
    "hist_gradient_boosting": {
      "enabled": true,
      "max_depth": 3,
      "min_samples_leaf": 25,
      "n_estimators": 200,
      "learning_rate": 0.03,
      "random_state": 7
    },
    "xgboost": {
      "enabled": true,
      "objective": "reg:squarederror",
      "tree_method": "hist",
      "n_estimators": 800,
      "max_depth": 4,
      "learning_rate": 0.03,
      "min_child_weight": 50,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_lambda": 10.0,
      "reg_alpha": 0.1,
      "max_bin": 256,
      "random_state": 7,
      "device": "runtime_override_cpu_or_cuda",
      "hyperparameter_search": false
    }
  },
  "negative_controls": {
    "enabled": true,
    "feature_set": "primary_set_only",
    "seeds": [7, 17, 29],
    "shuffle_scope": "within_training_day",
    "no_p_values_from_row_count": true
  },
  "engineering": {
    "processed_layout": "partitioned_parquet_symbol_day",
    "compression": "zstd",
    "atomic_artifact_writes": true,
    "deterministic_task_ids": true,
    "resume_completed_tasks": true,
    "one_process_per_gpu": true,
    "default_gpu_devices": [0, 1],
    "cpu_thread_oversubscription_forbidden": true,
    "record_wall_time": true,
    "record_peak_rss": true,
    "record_gpu_memory_when_available": true,
    "record_environment_manifest": true,
    "record_source_and_processed_hashes": true
  },
  "performance_benchmarks": {
    "representative_task": {
      "symbol": "PEKAO",
      "test_month": "2017-06",
      "horizon_events": 20,
      "model": "xgboost"
    },
    "compare": [
      "cpu_xgboost_vs_single_gpu_xgboost",
      "serial_single_gpu_tasks_vs_two_gpu_parallel_tasks",
      "cold_prepare_vs_cached_feature_reuse"
    ],
    "scientific_metrics_must_not_be_selected_by_runtime": true
  },
  "publication": {
    "commit_raw_data": false,
    "commit_processed_row_level_data": false,
    "commit_row_level_predictions": false,
    "commit_aggregate_metrics": true,
    "commit_resource_metrics": true,
    "commit_small_plots": true,
    "require_dataset_attribution": true
  }
}
